# Plantilla de configuración. NO poner aquí valores reales.
# El fichero .env real se genera con:  python generar_claves.py

# Claves de sesión de Flask (una por servidor)
AUTH_SERVER_SECRET_KEY=cambiar
PORTAL_SECRET_KEY=cambiar

# Secreto del cliente confidencial "hospital-web" (lo comparten los dos servidores)
CLIENT_SECRET=cambiar

# Clave privada RSA con la que el servidor de identidad firma los JWT (RS256)
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem

# Emisor y audiencia que se escriben en el JWT y que el portal exige al validarlo
OAUTH_ISSUER=http://localhost:8000
OAUTH_AUDIENCE=hospital-api

# 1 = la cookie de sesión solo viaja por HTTPS (Chrome y Firefox la aceptan en http://localhost)
# 0 = solo para pruebas con curl o scripts sobre HTTP
COOKIE_SECURE=1
